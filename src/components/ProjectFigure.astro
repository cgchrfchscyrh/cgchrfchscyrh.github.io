---
import { labFigures } from "../data/lab-figures";
import { asset } from "../data/profile";
interface Props { id: string; hero?: boolean; notes?: boolean; quiet?: boolean; linked?: boolean; tag?: string; }
const { id, hero = false, notes = false, quiet = false, linked = true, tag } = Astro.props;
const figure = labFigures[id];
const url = asset(`projects/${figure.project}/${figure.file}`);
const displayUrl = asset(`projects/${figure.project}/${figure.preview || figure.file}`);
const described = notes || quiet;
const ImageWrapper = linked ? "a" : "div";
---
<figure class:list={["project-figure", { "tagged-figure": tag }]} data-figure={id}>
  <ImageWrapper class={linked ? "figure-link" : "figure-static"} href={linked ? url : undefined} aria-label={linked ? `Open full-size image: ${figure.title}` : undefined}><img src={displayUrl} width={figure.width} height={figure.height} alt={figure.alt} aria-describedby={described ? `image-${id}-description` : undefined} loading={hero ? "eager" : "lazy"} decoding="async" /></ImageWrapper>
  {tag && <p class="media-tag" aria-hidden="true">{tag}</p>}
  {quiet && <div class="sr-only"><p id={`image-${id}-description`}>{figure.description}</p><p class="source-credit">Source: {figure.source}</p></div>}
  {!described && <figcaption><p>{figure.title}</p><details><summary>Image description & source</summary><p>{figure.description}</p><p class="source-credit">Source: {figure.source}</p></details></figcaption>}
</figure>
