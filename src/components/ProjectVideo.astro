---
import { projectClips } from "../data/lab-projects";
import { asset } from "../data/profile";
interface Props { id: string; hero?: boolean; transcriptHref?: string; credits?: boolean; }
const { id, hero = false, transcriptHref, credits = false } = Astro.props;
const clip = projectClips.find(item => item.id === id)!;
const base = `projects/${clip.assetProject || clip.project}/${clip.assetId || clip.id}`;
const version = clip.mediaVersion ? `?v=${encodeURIComponent(clip.mediaVersion)}` : "";
---
<figure class="project-video">
  <video id={`${id}-video`} data-playback-group={hero ? "hero" : "research"} controls controlslist="nodownload" muted playsinline loop={clip.loop !== false} preload={hero ? "metadata" : "none"} width="1280" height="720" poster={asset(`${base}.jpg`) + version} aria-label={clip.title} aria-describedby={`${id}-description`}>
    <source src={asset(`${base}.mp4`) + version} type="video/mp4" />
    {clip.captions && <track kind="captions" src={asset(`${base}.en.vtt`) + version} srclang="en" label="English captions" default />}
    <track kind="descriptions" src={asset(`${base}.vtt`) + version} srclang="en" label="English visual descriptions" />
    Your browser does not support video playback. {transcriptHref ? <a href={transcriptHref}>Read the chapter text.</a> : "A text description follows this player."}
  </video>
  <p id={`${id}-description`} class="sr-only">{clip.description} {clip.audioNote}{credits && <span class="source-credit"> Source: {clip.sourceLabel || clip.sourceFile}. {clip.sourceRange}.</span>}</p>
</figure>
