---
import Video from "../ProjectVideo.astro";
import Playback from "../ProjectPlayback.astro";
import Figure from "../ProjectFigure.astro";
import "../../styles/healthy.css";
const papers = [
  { area: "BIM-based modeling", title: "Integrated environment-occupant-pathogen information modeling to assess and communicate room-level outbreak risks of infectious diseases", authors: "Shuai Li, Yifang Xu, Jiannan Cai, Da Hu, Qiang He", venue: "Building and Environment · 2021", doi: "https://doi.org/10.1016/j.buildenv.2020.107394", html: "https://pmc.ncbi.nlm.nih.gov/articles/PMC7584519/", note: "Connects building information, occupancy, and pathogen parameters for room-level surface-mediated transmission modeling and risk communication." },
  { area: "Predictive simulation", title: "Simulation-based trade-off modeling for indoor infection risk of airborne diseases, energy consumption, and thermal comfort", authors: "Yifang Xu, Jianli Chen, Jiannan Cai, Shuai Li, Qiang He", venue: "Journal of Building Engineering · 2023", doi: "https://doi.org/10.1016/j.jobe.2023.107137", html: "", note: "Compares infection-risk, energy, and comfort trade-offs through building simulations. This is scenario-based evidence, rather than validation of a live digital twin." },
  { area: "AI-enabled intervention", title: "Recognizing object surface materials to adapt robotic disinfection in infrastructure facilities", authors: "Da Hu, Shuai Li", venue: "Computer-Aided Civil and Infrastructure Engineering · 2022", doi: "https://doi.org/10.1111/mice.12811", html: "", note: "Uses visual material recognition and transmission modeling to inform adaptive robotic disinfection. It is separate from the simulation demonstration on this page." },
];
---
<section class="healthy-hero" aria-labelledby="project-title">
  <div class="healthy-hero-copy">
    <h1 id="project-title">AI-Empowered<br /> Healthy Built Environments</h1>
  </div>
  <p id="media-status" class="sr-only" role="status"></p>
</section>
<div class="project-content healthy-content">
  <div class="healthy-research" id="innovations">
    <article class="healthy-strand" id="modeling" aria-labelledby="modeling-title">
      <div class="healthy-strand-head"><span class="healthy-index" aria-hidden="true">01</span><div><h2 id="modeling-title">BIM-based environmental<br /> and exposure modeling</h2><p>Organize rooms, systems, and occupant activities in a shared spatial model. Connect that model with environmental processes to investigate exposure pathways and compare scenarios.</p></div></div>
      <Figure id="twin-framework" quiet linked={false} />
    </article>
    <article class="healthy-strand" id="prediction" aria-labelledby="prediction-title">
      <div class="healthy-strand-head"><span class="healthy-index" aria-hidden="true">02</span><div><h2 id="prediction-title">Digital twins for<br /> real-time prediction</h2><p>Develop models that update with sensor observations and changing occupancy—estimating current conditions, forecasting change, and comparing possible responses.</p></div></div>
      <div class="healthy-prediction-media">
        <Video id="healthy-indoor-transport" credits />
        <Video id="healthy-building-layers" credits />
      </div>
      <div class="healthy-process" aria-labelledby="prediction-loop-title"><h3 id="prediction-loop-title">Research direction</h3><ol><li><strong>Observe</strong><span>Sensors &amp; occupancy</span></li><li><strong>Estimate</strong><span>Current conditions</span></li><li><strong>Forecast</strong><span>Changes &amp; uncertainty</span></li><li><strong>Compare</strong><span>Possible responses</span></li></ol></div>
    </article>
    <article class="healthy-strand" id="response" aria-labelledby="response-title">
      <div class="healthy-strand-head"><span class="healthy-index" aria-hidden="true">03</span><div><h2 id="response-title">AI-driven control and<br /> human–building interaction</h2><p>Investigate how predictions can inform building controls, robotic intervention, and guidance that occupants can understand and shape.</p></div></div>
      <div class="healthy-response-media"><div><h3>Robotic intervention · Simulation</h3><Video id="healthy-disinfection-simulation" credits /></div><div><h3>Human–robot interaction</h3><Figure id="occupant-interaction" quiet linked={false} /></div></div>
      <div class="healthy-dialogue" role="group" aria-labelledby="interaction-title"><div><h3 id="interaction-title">A person asks.<br /> The building helps them reason.</h3><p>Natural-language interfaces could connect occupant questions and feedback with building information and analytical tools.</p></div><ol aria-label="Proposed human–building interaction"><li><span>Occupant</span><strong>Questions &amp; preferences</strong></li><li><span>AI interface</span><strong>Building data &amp; models</strong></li><li><span>Shared decision</span><strong>Options &amp; feedback</strong></li></ol></div>
    </article>
  </div>
  <section class="project-section" id="publications" aria-labelledby="publications-title">
    <div class="healthy-heading"><p class="healthy-stage">Research &amp; publications</p><h2 id="publications-title">Evidence across modeling,<br /> prediction, and intervention.</h2><p>These studies establish individual parts of the research. Connecting them into a responsive building remains the larger challenge.</p></div>
    <div class="healthy-publications">{papers.map(paper => <article class="publication"><p class="healthy-stage">{paper.area}</p><div><p class="publication-meta">{paper.venue}</p><h3>{paper.title}</h3><p class="healthy-authors">{paper.authors}</p><p>{paper.note}</p><p class="healthy-doi">DOI: {paper.doi.replace("https://doi.org/", "")}</p></div></article>)}</div>
  </section>
  <section class="healthy-collaboration" id="collaborate" aria-labelledby="collaborate-title"><div><p class="healthy-stage">Research team &amp; collaborators</p><h2 id="collaborate-title">A shared space for<br /> different kinds of expertise.</h2></div><div><p>Building science · AI &amp; robotics · Human factors · Facility operations</p></div></section>
</div>
<Playback />
