---
import Video from "../ProjectVideo.astro";
import Playback from "../ProjectPlayback.astro";
import Figure from "../ProjectFigure.astro";
import { labProjects } from "../../data/lab-projects";
import "../../styles/healthy.css";
const project = labProjects.find(item => item.slug === "digitaltwin_healthybuilding")!;
// Records follow Crossref (checked 10 November 2026), newest first.
const papers = [
  { title: "Simulation-Based Trade-Off Modeling for Indoor Infection Risk of Airborne Diseases, Energy Consumption, and Thermal Comfort", authors: "Yifang Xu, Jianli Chen, Jiannan Cai, Shuai Li, Qiang He", venue: "Journal of Building Engineering, 76, 107137", year: "2023", doi: "10.1016/j.jobe.2023.107137" },
  { title: "Integrated Environment-Occupant-Pathogen Information Modeling to Assess and Communicate Room-Level Outbreak Risks of Infectious Diseases", authors: "Shuai Li, Yifang Xu, Jiannan Cai, Da Hu, Qiang He", venue: "Building and Environment, 187, 107394", year: "2021", doi: "10.1016/j.buildenv.2020.107394" },
  { title: "Understanding Building-Occupant-Microbiome Interactions Toward Healthy Built Environments: A Review", authors: "Shuai Li, Zhiyao Yang, Da Hu, Liu Cao, Qiang He", venue: "Frontiers of Environmental Science & Engineering, 15(4), 65", year: "2021", doi: "10.1007/s11783-020-1357-3" },
];
---
<section class="healthy-hero" aria-labelledby="project-title">
  <div class="healthy-hero-copy">
    <h1 id="project-title">Digital Twins for<br /> Healthy Built Environments</h1>
    <p class="healthy-subtitle">{project.subtitle}</p>
  </div>
  <p id="media-status" class="sr-only" role="status"></p>
</section>
<div class="project-content healthy-content">
  <section class="healthy-vision" id="research-vision" aria-labelledby="research-vision-title">
    <h2 id="research-vision-title">Research Vision</h2>
    <div class="healthy-vision-copy">
      <p class="healthy-vision-lead">We explore how digital twins and intelligent technologies can transform built environments into healthier, more responsive spaces.</p>
      <p>By integrating building information, environmental sensing, and computational modeling, we seek to better understand indoor health risks and predict environmental dynamics. We further investigate social robotics to enable natural, context-aware interactions between people and intelligent built environments.</p>
    </div>
  </section>
  <div class="healthy-research" id="innovations">
    <article class="healthy-strand" id="modeling" aria-labelledby="modeling-title">
      <div class="healthy-strand-head"><p class="healthy-index">01 — Understand</p><div><h2 id="modeling-title">Modeling Building–Occupant–Environment Interactions</h2><p>We integrate building information, occupant activities, and environmental data to characterize exposure pathways and assess spatial variations in indoor health risks.</p></div></div>
      <Figure id="twin-framework" quiet linked={false} />
    </article>
    <article class="healthy-strand" id="prediction" aria-labelledby="prediction-title">
      <div class="healthy-strand-head"><p class="healthy-index">02 — Predict</p><div><h2 id="prediction-title">Digital Twins for Indoor Health Intelligence</h2><p>We develop digital twins to simulate evolving indoor conditions, predict potential exposure risks, and support health-informed building management.</p></div></div>
      <div class="healthy-prediction-media">
        <Video id="healthy-indoor-transport" credits />
        <Video id="healthy-building-layers" credits />
      </div>
    </article>
    <article class="healthy-strand" id="engage" aria-labelledby="engage-title">
      <div class="healthy-strand-head"><p class="healthy-index">03 — Engage</p><div><h2 id="engage-title">Social Robotics &amp; <span class="healthy-nowrap">Human–Robot</span> Interaction</h2><p>We investigate how social robots perceive, communicate, and interact with occupants in shared indoor environments. Our research explores natural, context-aware interactions that can enhance human engagement and support occupant needs.</p></div></div>
      <div class="healthy-engage-media"><Figure id="occupant-interaction" quiet linked={false} /></div>
    </article>
  </div>
  <section class="project-section" id="publications" aria-labelledby="publications-title">
    <h2 id="publications-title" class="healthy-publications-title">Selected Publications</h2>
    <ol class="healthy-pub-list">
      {papers.map(paper => <li>
        <h3>{paper.title}</h3>
        <p class="healthy-authors">{paper.authors}</p>
        <p class="healthy-venue"><span>{paper.venue}</span> · {paper.year}</p>
        <p class="healthy-doi">DOI: {paper.doi}</p>
      </li>)}
    </ol>
  </section>
</div>
<Playback />
