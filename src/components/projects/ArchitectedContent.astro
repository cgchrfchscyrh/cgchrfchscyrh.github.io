---
import Video from "../ProjectVideo.astro";
import Figure from "../ProjectFigure.astro";
import Playback from "../ProjectPlayback.astro";
import "../../styles/architected.css";
---
<section class="architected-hero" id="module-demo" aria-labelledby="project-title">
  <div class="architected-hero-intro"><h1 id="project-title">Design and Robotic Assembly <br /> of Architected Structures</h1></div>
  <p id="media-status" class="sr-only" role="status"></p>
</section>
<div class="architected-content">
  <div class="architected-research" id="innovations">
    <article class="architected-strand" id="material-design" aria-labelledby="material-title">
      <div class="architected-strand-copy"><span class="architected-number" aria-hidden="true">01</span><h2 id="material-title">Architected material<br /> and module design</h2><p>Explore how porosity and internal architecture shape modular components. Bring functional design, manufacturability, and robotic accessibility together from the beginning.</p></div>
      <div class="architected-material-pair"><div><h3>Module concept</h3><Figure id="module" quiet linked={false} /></div><div><h3>Fabrication reference</h3><Figure id="manufacturing" quiet linked={false} /></div></div>
    </article>
    <article class="architected-strand architected-joint" id="joint-demo" aria-labelledby="joint-title">
      <div class="architected-strand-copy"><span class="architected-number" aria-hidden="true">02</span><h2 id="joint-title">Assembly-oriented<br /> connection design</h2><p>Joint geometry defines how components approach, align, and engage. Study insertion directions alongside structural requirements and manufacturing tolerances.</p></div>
      <Video id="structures-families" credits />
      <div class="architected-connections">
        <Figure id="connections" quiet linked={false} />
        <Figure id="breakwater" quiet linked={false} />
      </div>
    </article>
    <article class="architected-planning" id="planning" aria-labelledby="planning-title">
      <div class="architected-planning-head"><span class="architected-number" aria-hidden="true">03</span><h2 id="planning-title">Robotic assembly<br /> planning and execution</h2></div>
      <div id="demonstrations">
        <div id="assembly-demo"><Video id="structures-assembly" credits /></div>
      </div>
    </article>
  </div>
</div>
<Playback />
