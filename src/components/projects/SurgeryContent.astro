  { number: "03", title: "Agentic AI for Surgical Robotics", challenge: "Surgical robots must move beyond passive perception toward task-aware reasoning, adaptive decision-making, and coordinated actions under surgeon supervision.", direction: "Perception, Reasoning, and Control for Intelligent Surgical Assistance", target: "visual-ai" },
