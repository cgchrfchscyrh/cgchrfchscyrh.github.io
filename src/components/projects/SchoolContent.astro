---
import Video from "../ProjectVideo.astro";
import Playback from "../ProjectPlayback.astro";
import chapters from "../../data/school-chapters.json";
import "../../styles/school.css";
---
<div class="school-content">
  <section class="school-intro" aria-labelledby="project-title">
    <h1 id="project-title">Disease-Resistant<br /> School Communities</h1>
    <p>Balancing in-person schooling, airborne infection risk and energy cost.</p>
  </section>
  <p id="media-status" class="sr-only" role="status"></p>
  {chapters.map((chapter, index) => <section class="school-chapter" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
    <div class="school-chapter-copy">
      <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>
      <div id={`${chapter.id}-narration`} class="school-narration">{chapter.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
    </div>
    <Video id={chapter.id} hero={index === 0} transcriptHref={`#${chapter.id}-narration`} />
  </section>)}
  <section class="school-study" id="publications" aria-labelledby="school-study-title">
    <div><h2 id="school-study-title">The study behind the film</h2><p>COVID-19 scenario modeling · Journal of Building Engineering · 2022</p></div>
    <div>
      <p><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC8556188/">Nationwide assessment of energy costs and policies to limit airborne infection risks in U.S. schools</a></p>
      <p class="school-authors">Jiannan Cai, Shuai Li, Da Hu, Yifang Xu, Qiang He</p>
    </div>
  </section>
</div>
<Playback />
