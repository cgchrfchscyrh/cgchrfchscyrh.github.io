---
import "@fontsource-variable/ibm-plex-sans";
import "../styles/global.css";
import { asset, profile } from "../data/profile";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "Songyang Liu | Robotics & Learning",
  description = "Songyang Liu is a Ph.D. student at the University of Florida studying robot learning, humanoid whole-body control, and autonomous systems.",
  noindex = false,
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        canonical && <link rel="canonical" href={canonical} />
      )
    }
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && canonical && <meta property="og:url" content={canonical} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={asset("")}
          >Songyang Liu<span class="muted"> / Research</span></a
        >
        <nav aria-label="Main navigation">
          <a href={asset("#about")}>About</a>
          <a href={asset("#research")}>Research</a>
          <a
            href={asset("cv/")}
            aria-current={Astro.url.pathname.endsWith("/cv/")
              ? "page"
              : undefined}>CV</a
          >
          <a href={`mailto:${profile.email}`}>Contact</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div class="footer-row">
          <p>© 2026 Songyang Liu</p><nav aria-label="Footer">
            <a href={asset("accessibility/")}>Accessibility</a><a href="#main"
              >Back to top ↑</a
            >
          </nav>
        </div>
        <p>
          This is a personal research website, maintained by Songyang Liu. It is
          not an official University of Florida website. The research, views,
          and opinions expressed here are those of the authors and do not
          represent the official position of the University of Florida.
        </p>
        <p class="footer-small">
          Updated {profile.updated}. Layout inspired by <a
            href="https://wangmmstar.github.io/"
            >Mengjun Wang’s academic homepage</a
          >.
        </p>
      </footer>
    </div>
  </body>
</html>
