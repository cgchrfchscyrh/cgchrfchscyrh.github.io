---
import stories from "../data/vision-stories.json";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import ProjectFigureNotes from "../components/ProjectFigureNotes.astro";
import ProjectMediaNotes from "../components/ProjectMediaNotes.astro";
import ProjectVideo from "../components/ProjectVideo.astro";
import ProjectFigure from "../components/ProjectFigure.astro";
import ProjectPlayback from "../components/ProjectPlayback.astro";
import BuildingVision from "../components/projects/BuildingVision.astro";
import DigitalTwinContent from "../components/projects/DigitalTwinContent.astro";
import SurgeryContent from "../components/projects/SurgeryContent.astro";
import SurgeryHero from "../components/projects/SurgeryHero.astro";
import MicrobiomeContent from "../components/projects/MicrobiomeContent.astro";
import DisinfectionContent from "../components/projects/DisinfectionContent.astro";
import AssemblyContent from "../components/projects/AssemblyContent.astro";
import ArchitectedContent from "../components/projects/ArchitectedContent.astro";
import HealthyContent from "../components/projects/HealthyContent.astro";
import SchoolContent from "../components/projects/SchoolContent.astro";
import { labProjects, immunologyPublications } from "../data/lab-projects";
export function getStaticPaths() { return labProjects.map(project => ({ params: { project: project.slug }, props: { project } })); }
const { project } = Astro.props;
const story = stories[project.slug as keyof typeof stories];
const surgery = project.slug === "agentic-robotics_surgeons";
const disinfection = project.slug === "disinfection-robot";
const micro = project.slug === "building-immunology";
const assembly = project.slug === "robotic-block-assembly";
const papers = [4,5,6,0,1,2,3];
const school = project.slug === "disease-resistant-school-communities";
const healthy = project.slug === "healthy-built-environments";
const architected = project.slug === "architected-structures";
const nav = architected ? [{ id: "problem", label: "Problem" }, { id: "innovations", label: "Research" }, { id: "demonstrations", label: "Demos" }, { id: "application", label: "Application" }, { id: "vision", label: "Vision" }] : healthy ? [{ id: "problem", label: "Problem" }, { id: "innovations", label: "Innovations" }, { id: "publications", label: "Research" }, { id: "vision", label: "Vision" }] : school ? [{ id: "problem", label: "Problem" }, { id: "solutions", label: "Solutions" }, { id: "impact", label: "Impact" }, { id: "publications", label: "Research" }] : assembly ? [{ id: "abstract", label: "Concept" }, { id: "method", label: "Method" }, { id: "assembly", label: "Assembly" }, { id: "vision", label: "Vision" }]
  : surgery ? [{ id: "problems", label: "Challenges" }, { id: "innovations", label: "Research" }, { id: "research-vision", label: "Vision" }, { id: "publications", label: "Publications" }]
  : micro ? [{ id: "abstract", label: "Question" }, { id: "communities", label: "Microbiomes" }, { id: "method", label: "Method" }, { id: "simulation", label: "Digital twins" }, { id: "room-risk", label: "Room-level risk" }, { id: "vision", label: "Vision" }, { id: "publications", label: "Publications" }]
  : [{ id: "abstract", label: "Question" }, { id: "method", label: "Method" }, ...(surgery ? [{ id: "cleaning", label: "Cleaning concept" }] : [{ id: "navigation", label: "Navigation" }]), { id: "vision", label: "Vision" }, { id: "publications", label: "Publications" }];
---
<ProjectLayout title={healthy || architected || school || surgery ? project.title : `${project.shortTitle} — ${story.headline}`} shortTitle={project.shortTitle} description={project.description} slug={project.slug} source={project.source} nav={nav} bare={surgery || school || architected || healthy}>
  {architected ? <ArchitectedContent /> : healthy ? <HealthyContent /> : assembly ? <AssemblyContent sourceNotes={project.sourceNotes} /> : school ? <SchoolContent /> : <>
  {surgery ? <SurgeryHero /> : <section class:list={["project-hero", { "immunity-hero": micro }]} aria-labelledby="project-title">
    <div class="hero-copy"><h1 id="project-title" class="project-display-title">{story.headlineLines.map(line => <span class="display-line">{line}{" "}</span>)}</h1>{project.credit && <p class="project-credit">{project.credit}</p>}</div>
    <div class="hero-media paired">
      {project.heroClips.map(id => <ProjectVideo id={id} hero />)}
      {micro && <ProjectFigure id="building-immunity" hero notes />}
    </div>
    <p id="media-status" class="sr-only" role="status"></p>
  </section>}
  <div class="project-content">
    {!surgery && <section class="project-section abstract" id="abstract" aria-labelledby="abstract-title"><h2 id="abstract-title">{project.question}</h2><p class="lead">{project.abstract}</p></section>}
    {surgery && <SurgeryContent />}
    {micro && <><MicrobiomeContent /><DigitalTwinContent /><BuildingVision /></>}
    {disinfection && <DisinfectionContent />}
    {!surgery && <><section class="project-section publications" id="publications" aria-labelledby="publications-title"><div class="section-heading"><p class="eyebrow">Further reading</p><h2 id="publications-title">Publications</h2></div>
      {disinfection && <article class="publication immunity-publication"><p class="publication-meta">Material-adaptive robotic disinfection · 2022</p><h3><a href="https://doi.org/10.1111/mice.12811">Recognizing object surface materials to adapt robotic disinfection in infrastructure facilities</a></h3><p>Da Hu, Shuai Li</p><p class="scope-note">Computer-Aided Civil and Infrastructure Engineering, 37, 1521–1546. The supplied Wiley infographic illustrates this study.</p></article>}
      {micro && <><p class="section-intro">Related research cited by the original Building Immunology project.</p><ol class="reference-list">{papers.slice(0,3).map(i => <li>{immunologyPublications[i]}</li>)}</ol>{papers.length > 3 && <details class="more-publications"><summary>More related publications</summary><ol class="reference-list" start="4">{papers.slice(3).map(i => <li>{immunologyPublications[i]}</li>)}</ol></details>}</>}
    </section>
    <section class="source-section" id="sources" aria-label="Project source materials"><details><summary>Sources & media notes</summary><p>The page uses supplied project materials. {micro || surgery ? "Image and video descriptions and credits are collected below." : "Source credits accompany the figures and publications; video credits are collected below."}</p><ul>{project.sourceNotes.map(note => <li>{note}</li>)}</ul><p>{micro ? "Images are extracted from the original materials. Full-size originals remain available by selecting an image." : "Images are extracted from the original materials; enlarged details are identified in their captions. Figure descriptions remain beside the images; video text alternatives and credits are collected here."}</p>{micro && <ProjectFigureNotes />}<ProjectMediaNotes project={project.slug} /></details></section></>}
  </div>
  {project.heroClips.length > 0 && <ProjectPlayback />}
  </>}
</ProjectLayout>
